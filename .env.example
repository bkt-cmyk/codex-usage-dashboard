# Required: normal Discord guild text channel ID
DASHBOARD_CHANNEL_ID=YOUR_CHANNEL_ID

# Required: comma- or space-separated Discord user IDs allowed to use controls
DASHBOARD_ALLOWED_USERS=YOUR_USER_ID

# Prefer reusing the token stored in HERMES_ENV. If using a separate bot,
# uncomment this locally and never commit the value.
# DISCORD_BOT_TOKEN=

# Optional. Defaults shown below are resolved from the current user's HOME.
# HERMES_HOME=/home/your-user/.hermes
# HERMES_ENV=/home/your-user/.hermes/.env
# HERMES_BIN=hermes
# DASHBOARD_STATE_FILE=data/state.json
# DASHBOARD_HISTORY_FILE=data/usage-history.sqlite
